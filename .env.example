# Create a bot with @BotFather and supply its token through your environment.
TELEGRAM_BOT_TOKEN=

# Optional: only website requests use this proxy; Telegram keeps its own route.
# Example format: http://LOGIN:PASSWORD@HOST:PORT or socks5://LOGIN:PASSWORD@HOST:PORT
# Store the real value in the hosting's secret/environment settings, not in Git.
BGMU_PROXY_URL=
