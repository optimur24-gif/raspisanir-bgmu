# Create a bot with @BotFather and supply its token through your environment.
TELEGRAM_BOT_TOKEN=

# Optional: only website requests use this proxy; Telegram keeps its own route.
# Example format: http://LOGIN:PASSWORD@HOST:PORT or socks5://LOGIN:PASSWORD@HOST:PORT
# Store the real value in the hosting's secret/environment settings, not in Git.
BGMU_PROXY_URL=

# Private persistent directory. Keep it across restarts and deployments.
BGMU_DATA_DIR=.data

# Telegram username, without @. Checked against the actual sender's username.
ADMIN_USERNAME=Timur0_15

# Separate original management bot: python -m restricted_bot
# Only accepts the identity of the bot in the attached file.
RESTRICTED_BOT_TOKEN=
# Its own original SQLite database/backups, separate from public preferences.
DATA_DIR=.data/restricted
